{
  "name": "sa-health-interop-backend",
  "version": "0.1.0",
  "description": "Phase 1 prototype backend for a South African healthcare interoperability platform (Grade 10 Science Expo project).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:gateway": "tsx watch src/api/gateway.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').mkdirSync('dist/config',{recursive:true});require('fs').copyFileSync('src/config/sources.json','dist/config/sources.json')\"",
    "start": "node dist/api/server.js",
    "start:gateway": "node dist/api/gateway.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node-pg-migrate up -m migrations --no-check-order",
    "db:migrate:down": "node-pg-migrate down -m migrations --no-check-order",
    "generate-adapter": "tsx scripts/generateAdapter.ts",
    "reset-demo": "tsx scripts/resetDemoData.ts",
    "lint": "eslint src tests scripts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fastify/http-proxy": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.4"
  }
}
