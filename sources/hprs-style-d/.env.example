DATABASE_PATH=./hprs-style-d.sqlite
PORT=4004
API_KEY=hprs-style-d-dev-key-change-me

# Field-level encryption key for sa_id_number (see src/encryption.ts).
# Must be set identically for both `npm run db:setup` and `npm run dev`/`start`,
# since data encrypted under one key cannot be decrypted under another.
SA_ID_ENCRYPTION_KEY=change-me-to-a-long-random-secret-in-any-real-deployment
