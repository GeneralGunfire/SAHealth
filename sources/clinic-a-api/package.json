{
  "name": "clinic-a-api",
  "version": "0.1.0",
  "description": "Standalone simulated source system API for Clinic A. Independent of the main interop backend.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:setup": "tsx src/setup.ts",
    "db:migrate": "node-pg-migrate up -m migrations --no-check-order",
    "db:migrate:down": "node-pg-migrate down -m migrations --no-check-order"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
